          "expr": "WITH (\n    nodes = count by (nodeset_name, node_name) (\n        slurm_node_info{cluster=~\"$cluster\", \n            nodeset_name=~\"$nodeset\"\n        }\n    ),\n\n    healthy = count by (nodeset_name, node_name) (\n        slurm_node_info{cluster=~\"$cluster\", \n            state_base=~\"IDLE|ALLOCATED\",\n            state_is_maintenance!=\"true\",\n            state_is_not_responding!=\"true\",\n            nodeset_name=~\"$nodeset\"\n        }\n    ),\n\n    total_nodes = count(nodes) by (nodeset_name),\n\n    healthy_nodes = (\n        count(healthy) by (nodeset_name)\n        or 0 * total_nodes\n    )\n)\n\n2\n+ (healthy_nodes > bool 0)\n- 2 * (healthy_nodes == bool total_nodes)",
